@startuml
skinparam activityArrowThickness 2
skinparam roundcorner 10

|Artist or Provider|
start
:Opens Earnings Dashboard;
:Clicks "Request Payout";

|Frontend|
:GET /payouts/balance;

|Database|
:Calculate pending balance (completed sales - previous payouts);

|Backend|
:Return balance summary;

|Frontend|
:Display available balance;
:Show payout form (bank account / e-wallet details);

|Artist or Provider|
:Enters withdrawal amount;
:Confirms payout method;

|Frontend|
:POST /payouts { amount, method, account_details };

|Backend|
:Validate amount <= available_balance;
if (insufficient balance?) then (yes)
  :Return 400 Insufficient balance;
  stop
endif

:Validate minimum payout threshold;
if (below minimum?) then (yes)
  :Return 400 Below minimum threshold;
  stop
endif

|Database|
:Create Payout record { status: PENDING };

|Backend|
:Queue payout for processing;
:Return 201 Created;

|Frontend|
:Show "Payout request submitted - processing in 1-3 business days" message;
stop
@enduml
